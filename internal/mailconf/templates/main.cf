# EmailZit: written by the root helper from the server settings.
# Changes here are overwritten; mail domains, mailboxes and aliases live in
# PostgreSQL (database {{.DBName}}) and are read through the maps in
# /etc/postfix/emailzit.
compatibility_level = 3.6
myhostname = {{.Hostname}}
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
recipient_delimiter = +
message_size_limit = {{.MaxBytes}}
mailbox_size_limit = 0
disable_vrfy_command = yes
smtpd_helo_required = yes
strict_rfc821_envelopes = yes
show_user_unknown_table_name = no
smtputf8_enable = yes
# a signed-in sender is one of ours: complete a message that arrives without
# Date or Message-ID (some mail programs leave them out, and receivers count
# that as spam)
local_header_rewrite_clients = permit_inet_interfaces, permit_sasl_authenticated
# never tell who exists by bouncing late: unknown recipients are refused
# during the SMTP dialogue
smtpd_reject_unlisted_recipient = yes
smtpd_reject_unlisted_sender = yes

# ---- TLS
smtpd_tls_cert_file = {{.CertFile}}
smtpd_tls_key_file = {{.KeyFile}}
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
# never anonymous or weak suites, not even for opportunistic TLS on port 25
smtpd_tls_exclude_ciphers = aNULL, eNULL, EXPORT, DES, 3DES, RC4, MD5, PSK, SRP, SEED, IDEA
smtpd_tls_mandatory_exclude_ciphers = aNULL, eNULL, EXPORT, DES, 3DES, RC4, MD5, PSK, SRP, SEED, IDEA
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_security_level = {{if .RelayUser}}encrypt{{else if .DANE}}dane{{else}}may{{end}}
{{- if .DANE}}
# DNSSEC-validated answers from the local resolver: servers that publish
# DANE (TLSA) records get mail only over TLS with the certificate named there
smtp_dns_support_level = dnssec
{{- end}}
{{- if and .TLSPolicySocket (not .Relay)}}
# MTA-STS: domains that ask for it get mail only over TLS to their listed
# servers (EmailZit looks the policies up)
smtp_tls_policy_maps = socketmap:unix:{{.TLSPolicySocket}}:mtasts
{{- end}}
smtp_tls_protocols = >=TLSv1.2
smtp_tls_loglevel = 1
# trusted CAs for "secure" (MTA-STS) and the smart host
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
# mail programs and smart hosts (the "high" grade: submission, IMAP, POP3)
# get only forward-secret AEAD suites; port 25 keeps the wider "medium"
# grade, since any encryption beats none for mail between servers
tls_high_cipherlist = ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20
tls_preempt_cipherlist = yes
# post-quantum key exchange first (TLS 1.3, OpenSSL 3.5 of Debian 13)
tls_eecdh_auto_curves = X25519MLKEM768 X25519 X448 prime256v1 secp384r1 secp521r1
# no SHA-1 or SHA-224 signatures in TLS 1.2 (openssl.cnf next to the maps)
tls_config_file = {{.OpenSSLConf}}
tls_config_name = postfix

# ---- virtual domains (EmailZit)
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/emailzit/domains.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/emailzit/mailboxes.cf
virtual_alias_maps = proxy:pgsql:/etc/postfix/emailzit/aliases.cf
virtual_transport = lmtp:unix:private/dovecot-lmtp
# dmarc-reports@<domain> goes to the EmailZit server (emailzit-dmarc in master.cf)
transport_maps = proxy:pgsql:/etc/postfix/emailzit/transport.cf
{{- if .SenderTransports}}
# customers with their own outbound address send through its transport
# (master.cf: own address and HELO name)
sender_dependent_default_transport_maps = proxy:pgsql:/etc/postfix/emailzit/sendertransport.cf
{{- end}}
smtpd_sender_login_maps = proxy:pgsql:/etc/postfix/emailzit/senders.cf
proxy_read_maps = $local_recipient_maps $mydestination $virtual_alias_maps $virtual_alias_domains $virtual_mailbox_maps $virtual_mailbox_domains $relay_recipient_maps $relay_domains $canonical_maps $sender_canonical_maps $recipient_canonical_maps $relocated_maps $transport_maps $mynetworks $smtpd_sender_login_maps $smtpd_sender_restrictions $sender_dependent_default_transport_maps

# ---- sign-in of mail programs: only on submission (465, 587), through Dovecot
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
broken_sasl_auth_clients = no

# ---- port 25: mail from other servers. No relaying for anyone; nobody may
# use an address of this server as sender without signing in. Not even
# programs on this server are trusted here (websites of a hosting server):
# they send through submission with an app password like everyone else.
smtpd_client_restrictions = reject_unauth_pipelining
smtpd_helo_restrictions = reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain, check_sender_access proxy:pgsql:/etc/postfix/emailzit/localsender.cf
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unauth_destination
smtpd_data_restrictions = reject_unauth_pipelining, reject_multi_recipient_bounce
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 100
smtpd_client_recipient_rate_limit = 300
smtpd_client_new_tls_session_rate_limit = 100
smtpd_client_auth_rate_limit = 30
smtpd_error_sleep_time = 5s
# Programs on this server do not use Postfix's sendmail (websites use
# emailzit-sendmail, which counts their mail); only root may.
authorized_submit_users = root
authorized_mailq_users = root
authorized_flush_users = root
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10
{{- if .PolicySocket}}
emailzit_policy = check_policy_service unix:{{.PolicySocket}}
{{- end}}
{{- if .Relay}}

# ---- all outgoing mail through a relay (smart host of the provider, or a lab sink)
relayhost = {{.Relay}}
{{- if .RelayUser}}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = texthash:{{.RelayPasswordFile}}
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
# the login only ever goes over TLS (smtp_tls_security_level above)
{{- if .RelayWrapper}}
smtp_tls_wrappermode = yes
{{- end}}
{{- end}}
{{- end}}
{{- if .Rspamd}}

# ---- Rspamd (spam, greylisting, DKIM signing) as a milter
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = accept
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
{{- end}}

# ---- postscreen in front of port 25: botnets that talk before the
# greeting or are on DNS block lists never reach smtpd (one listing on
# Spamhaus ZEN is enough, others count less; DNSWL lowers the score).
# The answers are checked, so a refusing resolver lists nobody.
postscreen_greet_action = enforce
postscreen_dnsbl_action = enforce
postscreen_dnsbl_threshold = 3
postscreen_dnsbl_allowlist_threshold = -2
postscreen_dnsbl_sites = zen.spamhaus.org=127.0.0.[2..11]*3, bl.spamcop.net=127.0.0.2*2, psbl.surriel.com=127.0.0.2*2, list.dnswl.org=127.0.[0..255].[1..3]*-2
postscreen_cache_map = btree:$data_directory/postscreen_cache
