# EmailZit: written by the root helper; changes are overwritten.
# service type  private unpriv  chroot  wakeup  maxproc command + args
smtp      inet  n       -       y       -       -       smtpd
# submission with STARTTLS (587) and over TLS (465): signed-in mail
# programs only, each login may send only from its own addresses
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=reject_non_fqdn_sender,reject_sender_login_mismatch,permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,reject_unknown_recipient_domain,{{if .PolicySocket}}$emailzit_policy,{{end}}permit_sasl_authenticated,reject
  -o smtpd_data_restrictions=reject_unauth_pipelining{{if .PolicySocket}},$emailzit_policy{{end}}
  -o smtpd_client_message_rate_limit=0
  -o milter_macro_daemon_name=ORIGINATING
submissions inet n      -       y       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=reject_non_fqdn_sender,reject_sender_login_mismatch,permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,reject_unknown_recipient_domain,{{if .PolicySocket}}$emailzit_policy,{{end}}permit_sasl_authenticated,reject
  -o smtpd_data_restrictions=reject_unauth_pipelining{{if .PolicySocket}},$emailzit_policy{{end}}
  -o smtpd_client_message_rate_limit=0
  -o milter_macro_daemon_name=ORIGINATING
# mail from websites (emailzit-sendmail): only the EmailZit server reaches
# this socket (group postdrop); it checks the sending limits of the hosting
# account and names it with XCLIENT, so the message is DKIM-signed. The
# sender need not be a mailbox (wordpress@…): EmailZit already checked that
# its domain is a verified domain of the same customer.
emailzit-submit unix n   -       y       -       -       smtpd
  -o syslog_name=postfix/emailzit-submit
  -o smtpd_tls_security_level=none
  -o smtpd_sasl_auth_enable=no
  -o smtpd_authorized_xclient_hosts=127.0.0.1
  -o smtpd_client_restrictions=
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=reject_non_fqdn_sender
  -o smtpd_reject_unlisted_sender=no
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,permit_sasl_authenticated,reject
  -o smtpd_data_restrictions=
  -o smtpd_client_message_rate_limit=0
  -o smtpd_client_connection_rate_limit=0
  -o milter_macro_daemon_name=ORIGINATING
# DMARC aggregate reports to dmarc-reports@<domain> (transport_maps): the
# EmailZit server stores them for the domain's page in the panels
emailzit-dmarc unix -    n       n       -       2       pipe
  flags=q user=emailzit argv=/usr/bin/emailzit-server --dmarc-report ${recipient}
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp{{if .IPv4Only}}
  -o inet_protocols=ipv4{{end}}
relay     unix  -       -       y       -       -       smtp{{if .IPv4Only}}
  -o inet_protocols=ipv4{{end}}
  -o syslog_name=postfix/$service_name
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       y       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
